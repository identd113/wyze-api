{
  "name": "wyze-api",
  "version": "2.0.0-beta.3",
  "description": "An unofficial API wrapper for Wyze products.",
  "homepage": "https://github.com/identd113/wyze-api",
  "main": "./src/index.js",
  "bin": {
    "wyze-api-fetch-wyze-sdk": "scripts/fetch-wyze-sdk.js"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "lint": "eslint src scripts tests --max-warnings=0",
    "test:future": "node --test future/*/test/*.test.js",
    "fetch-wyze-sdk": "node scripts/fetch-wyze-sdk.js",
    "tutk-smoke": "future/tutk/docker/run-tutk-smoke.sh",
    "tutk-smoke-real": "future/tutk/docker/run-real-camera-smoke.sh"
  },
  "keywords": [
    "wyze",
    "wyze-api",
    "api",
    "node",
    "sensors",
    "wyzecam",
    "wyze-node",
    "wyze bulbs",
    "wyze sense"
  ],
  "author": "Allen Farmer",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.0",
    "ffmpeg-static": "^5.3.0",
    "utf8": "3.0.0",
    "uuid-by-string": "4.0.0",
    "werift": "^0.25.1",
    "ws": "^8.20.0"
  },
  "directories": {
    "example": "example"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/identd113/wyze-api.git"
  },
  "bugs": {
    "url": "https://github.com/identd113/homebridge-wyze-smart-home/issues/new?template=bug-report.yml&origin=wyze-api"
  },
  "files": [
    "src",
    "scripts/*.js",
    "scripts/README.md",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
